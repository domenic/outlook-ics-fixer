{
  "name": "outlook-ics-fixer",
  "version": "1.0.0-pre",
  "description": "Repair missing Outlook calendar time zone definitions for private calendar subscriptions.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --import ./test/use-fixtures.mjs --test test/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "subscription-url": "node scripts/subscription-url.mjs"
  },
  "devDependencies": {
    "ical.js": "^2.2.1",
    "tar": "^7.5.22",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild": false,
    "workerd": false
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
